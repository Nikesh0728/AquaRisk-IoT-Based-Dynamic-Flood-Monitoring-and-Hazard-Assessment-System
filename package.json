{
  "name": "aquarisk",
  "private": true,
  "version": "1.0.0",
  "description": "AquaRisk - IoT-Based Dynamic Flood Monitoring and Hazard Assessment System",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production tsx server.ts",
    "serve": "npm run build && npm run start",
    "preview": "vite preview",
    "simulate": "tsx scripts/simulate-esp32.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^7.0.3",
    "typescript": "^7.0.2"
  }
}
