# Port the web app + API listen on
PORT=3000

# Optional: require ESP32 devices to send this key in the "x-api-key" header.
# Leave empty to accept telemetry from any device on your network.
DEVICE_API_KEY=

# Optional: enables the Gemini-written advisory on the dashboard.
# Without it, AquaRisk uses its built-in rule-based advisory.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
